if(NOT DEFINED MAHLER)
    message(FATAL_ERROR "MAHLER executable is required")
endif()

function(check expected_exit expected_output)
    execute_process(COMMAND "${MAHLER}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${status}" STREQUAL "${expected_exit}")
        message(FATAL_ERROR "${ARGN}: expected exit ${expected_exit}, got ${status}: ${error}")
    endif()
    if(NOT "${output}" STREQUAL "${expected_output}")
        message(FATAL_ERROR "${ARGN}: unexpected stdout: ${output}")
    endif()
    if(expected_exit EQUAL 0 AND NOT error STREQUAL "")
        message(FATAL_ERROR "${ARGN}: unexpected stderr: ${error}")
    elseif(NOT expected_exit EQUAL 0 AND NOT error MATCHES "^error: ")
        message(FATAL_ERROR "${ARGN}: missing error message")
    endif()
endfunction()

check(0 "7\n" digit 2020)
check(0 "0\n" digit 11 --format text)
check(0 "5\n" digit 18446744073709551615)
check(0 "{\"schema_version\":1,\"position\":\"2020\",\"digit\":7,\"source_number\":\"710\",\"digit_offset\":0,\"digit_count\":3}\n"
    digit 2020 --format json)
