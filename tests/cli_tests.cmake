execute_process(COMMAND "${MAHLER}" --help
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0 OR NOT output MATCHES "early reports first occurrence" OR NOT error STREQUAL "")
    message(FATAL_ERROR "help must explain the implemented phase")
endif()
